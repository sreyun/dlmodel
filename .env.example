# REQUIRED: set a strong random value before exposing the UI beyond localhost.
ADMIN_TOKEN=change-me-to-a-long-random-string
# SQLite app.db and settings live under DATA_DIR (compose: ./data/app -> /data).
# Model files live under MODEL_ROOT (compose: ./data/models -> /models).
# Both are durable across restarts; delete records only via UI or by removing those dirs.
MODEL_ROOT=/models
DATA_DIR=/data
HF_ENDPOINT=https://hf-mirror.com
HF_TOKEN=
MODELSCOPE_API_TOKEN=
ARIA2_RPC_URL=http://aria2:6800/jsonrpc
# Use a unique secret; do not reuse defaults in production.
ARIA2_RPC_SECRET=change-me-aria2-secret
DOWNLOAD_CONCURRENCY=2
ARIA2_CONNECTIONS=16
# Transient SSL/network retries for HTTP / ModelScope / aria2 (0 = no extra retries).
DOWNLOAD_RETRIES=3
OLLAMA_BASE_URL=http://ollama:11434
VLLM_BASE_URL=http://vllm:8000
# Concrete downloaded repo path for --profile vllm (not the /models/hf root).
VLLM_MODEL=
# Group-chat robot webhooks (DingTalk / Feishu / WeCom). Prefer UI settings; env is fallback.
# NOTIFY_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=...
# NOTIFY_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/...
# NOTIFY_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
# NOTIFY_ON_COMPLETED=1
# NOTIFY_ON_FAILED=1
# NOTIFY_ON_STARTED=0
# NOTIFY_ON_CANCELLED=0
# Production image (Huawei SWR). Default in docker-compose.yml is :latest.
# Pin a release when you need a fixed rollback target:
# DLMODEL_IMAGE=swr.cn-east-3.myhuaweicloud.com/sreyun/dlmodel:v0.3.2
# Local development (optional convenience):
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# Dev/tests only. Never enable on an exposed host.
# ALLOW_INSECURE_ADMIN=1
